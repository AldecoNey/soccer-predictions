# Copiar a .env y completar con valores reales. NUNCA commitear .env (ya está en .gitignore).

# Postgres (Neon) — connection string con sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# API-Football (api-sports.io) — ver ADR-0003
API_FOOTBALL_KEY=

# The Odds API — benchmark de cuotas, ver ADR-0003 (nunca feature del modelo)
ODDS_API_KEY=

ENVIRONMENT=development
